# Copia este archivo a ".env" y completa los valores del proyecto de Supabase.
# Debe ser la llave publica "anon", nunca la "service_role" (este proyecto
# es una SPA estatica: cualquier valor aqui queda visible en el navegador).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon-publica
